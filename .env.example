# Production Application Configuration
# Replace these with your actual Supabase production project credentials in your local .env file.
# NEVER commit your real .env file or production keys.
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_ANON_KEY=your-production-anon-key

# Isolated Test Project Configuration (Used ONLY by test suites)
# Tests will NEVER run against production. Configure a separate test project (e.g. medico-opd-test).
SUPABASE_TEST_URL=https://your-test-project.supabase.co
SUPABASE_TEST_ANON_KEY=your-test-anon-key
SUPABASE_TEST_SERVICE_ROLE_KEY=your-test-service-role-key
